{
  "name": "boardline",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "Whiteboards for Obsidian: flowcharts, mind maps, sequence diagrams, tables and sticky notes.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "screenshot": "node scripts/screenshot/capture.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "elkjs": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.13.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
